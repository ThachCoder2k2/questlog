# build output (rebuild: swiftc -O QuestCard.swift -o questcard -framework Cocoa -framework WebKit)
questcard
# runtime state
pending.json
applied.json
.questlog-*.json
.pending-*.json
# audio: sounds/*.wav are generated by make_sounds.py; sounds/custom holds your own files (kept local only)
sounds/*.wav
sounds/custom/*
!sounds/custom/README.txt
.DS_Store
# menu-bar button binary (rebuild: swiftc -O QuestBar.swift -o questbar -framework Cocoa -framework Carbon)
questbar
# runtime state of the runner (stamps, last cards, logs)
runs/
# phone push settings (holds the private topic)
push.json

# the Study tab: your learning roads, your progress and the theme you picked (local only)
learn.json
study.json
prefs.json
# theme sound packs, generated by cardsrc/make_theme_sounds.py
sounds/lcd/
sounds/calendar/
sounds/board/
sounds/soft/
sounds/mac/
